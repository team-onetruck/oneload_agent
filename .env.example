# python -m hangil_r2.config 를 실행하면 이 파일이 .env 로 복사된다. .env 에서 OPENAI_API_KEY= 뒤에 키만 넣으면 된다.
# .env 는 .gitignore 로 제외되어 git 에 올라가지 않는다. 키를 이 파일(.env.example)에 적지 말 것.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PROMPT_VERSION=v3
LLM_TIMEOUT_S=6
MAX_CLARIFY=2
AMBIGUITY_MARGIN=0.1
MAX_IMAGE_BYTES=2097152
